// Test harness: same worker, D1 only.
{
  "name": "college-tracker-test",
  "main": "worker/test-entry.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "dev": { "port": 8788 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "college-tracker-local",
      "database_id": "3f2a9c1e-7b64-4d18-9a2e-5c0d1b8f4e27"
    }
  ]
}
